{
  "name": "godot-generator-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for GodotGenerator.Blazor (dev: load Kestrel URL).",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dev:5044": "cross-env GODOT_BLAZOR_URL=http://127.0.0.1:5044 electron .",
    "dev:ci": "cross-env GODOT_BLAZOR_URL=http://127.0.0.1:5044 electron --no-sandbox .",
    "test": "node --test \"tests/**/*.test.cjs\"",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "dependencies": {
    "@ozymandros/electron-message-bridge": "^0.4.5",
    "@ozymandros/electron-message-bridge-plugin-speech-whisper": "^0.2.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "cross-env": "^10.1.0",
    "electron": "^41.1.1"
  }
}
