<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Godot_Generator_Avalonia.ViewModels"
             xmlns:conv="using:Godot_Generator_Avalonia.Converters"
             xmlns:cfg="using:GodotGenerator.Application.Configuration"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Godot_Generator_Avalonia.Views.ConfigView"
             x:DataType="vm:ConfigViewModel">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="24,12,24,24">
      <TextBlock Text="Configuration" Theme="{StaticResource MaterialHeadline4TextBlock}" FontWeight="Bold" Margin="0,0,0,4"/>
      <TextBlock Text="Manage your intelligence engines, models, and system prompts." Opacity="0.7" Theme="{StaticResource MaterialSubtitle1TextBlock}"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="24,0,24,12">
      <Button Content="Reload from host"
              Theme="{StaticResource MaterialFlatButton}"
              Command="{Binding ReloadAllCommand}"
              IsEnabled="{Binding !IsReloading}"/>
      <TextBlock Text="{Binding ShellErrorMessage}" Foreground="{DynamicResource MaterialSecondaryMidBrush}" VerticalAlignment="Center"
                 IsVisible="{Binding ShellErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>

    <TabControl SelectedIndex="{Binding SelectedSettingsTab}" 
                 Theme="{StaticResource MaterialTabControl}">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon Kind="CogOutline" Width="18" Height="18"/>
            <TextBlock Text="General" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Spacing="16" MaxWidth="840" Margin="0,8,0,0" DataContext="{Binding General}">
            <TextBlock Text="General Settings" Theme="{StaticResource MaterialHeadline5TextBlock}"/>

            <Border CornerRadius="8" Padding="12" Background="#0F111217" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="NETWORK &amp; API" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialPrimaryMidBrush}"/>
                <TextBlock Text="Backend URL" Opacity="0.8" FontSize="12"/>
                <TextBox Text="{Binding BackendUrl}" 
                         Watermark="http://127.0.0.1:35421" 
                         assists:TextFieldAssist.Label="Backend URL" 
                         Theme="{StaticResource OutlineTextBox}" />

                <TextBlock Text="Base path (output)" Opacity="0.8" FontSize="12"/>
                <TextBox Text="{Binding OutputBasePath}" 
                         Watermark="./output" 
                         assists:TextFieldAssist.Label="Base path (output)" 
                         Theme="{StaticResource OutlineTextBox}" />
                <TextBlock Text="Relative path for generated projects (stored in preferences)." Opacity="0.6" FontSize="11"/>
              </StackPanel>
            </Border>

            <Border CornerRadius="8" Padding="12" Background="#0F111217" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="PREFERRED INTELLIGENCE" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialPrimaryMidBrush}"/>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12">
                  <ComboBox Grid.Row="0" Grid.Column="0" Margin="0,8,0,8"
                            ItemsSource="{Binding ProviderOptions}"
                            IsEditable="True"
                            SelectedItem="{Binding LlmProvider}"
                            assists:ComboBoxAssist.Label="Default Text/Logic Provider"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,8,0,8"
                            ItemsSource="{Binding LlmModelOptions}"
                            IsEditable="True"
                            SelectedItem="{Binding LlmModel}"
                            assists:ComboBoxAssist.Label="Model (for text/llm)"/>

                  <ComboBox Grid.Row="1" Grid.Column="0" Margin="0,0,0,8"
                            ItemsSource="{Binding ProviderOptions}"
                            IsEditable="True"
                            SelectedItem="{Binding ImageProvider}"
                            assists:ComboBoxAssist.Label="Default Image Provider"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                            ItemsSource="{Binding ImageModelOptions}"
                            IsEditable="True"
                            SelectedItem="{Binding ImageModel}"
                            assists:ComboBoxAssist.Label="Model (for image)"/>

                  <ComboBox Grid.Row="2" Grid.Column="0" Margin="0,0,0,8"
                            ItemsSource="{Binding ProviderOptions}"
                            IsEditable="True"
                            SelectedItem="{Binding AudioProvider}"
                            assists:ComboBoxAssist.Label="Default Speech (TTS) Provider"/>
                  <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                            ItemsSource="{Binding AudioModelOptions}"
                            IsEditable="True"
                            SelectedItem="{Binding AudioModel}"
                            assists:ComboBoxAssist.Label="Model (for audio)"/>

                  <ComboBox Grid.Row="3" Grid.Column="0" Margin="0,0,0,0"
                            ItemsSource="{Binding ProviderOptions}"
                            IsEditable="True"
                            SelectedItem="{Binding VideoProvider}"
                            assists:ComboBoxAssist.Label="Default Video Provider"/>
                  <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,0"
                            ItemsSource="{Binding VideoModelOptions}"
                            IsEditable="True"
                            SelectedItem="{Binding VideoModel}"
                            assists:ComboBoxAssist.Label="Model (for video)"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Host defaults & diagnostics -->
            <Border CornerRadius="8" Padding="12" Background="#0F111217" BorderBrush="{DynamicResource MaterialDividerBrush}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock Text="HOST DEFAULTS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MaterialPrimaryMidBrush}"/>
                <TextBlock>
                  <Run Text="Default LLM: " FontWeight="Medium"/>
                  <Run Text="{Binding DefaultLlmProvider}" />
                </TextBlock>
                <TextBlock>
                  <Run Text="Default Chat ID: " FontWeight="Medium"/>
                  <Run Text="{Binding DefaultChatModelId}" />
                </TextBlock>
                <TextBlock>
                  <Run Text="Available Godot tools: " FontWeight="Medium"/>
                  <Run Text="{Binding GodotToolCount}" />
                </TextBlock>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
              <Button Content="Save All Changes" 
                      Command="{Binding SaveCommand}" 
                      Theme="{StaticResource MaterialFlatMidButton}" 
                      MinWidth="150"
                      Margin="0,12,0,0"/>
              <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDividerBrush}" VerticalAlignment="Center" Margin="8,14,0,0"/>
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MaterialSecondaryMidBrush}"
                         IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center" Margin="8,14,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon Kind="RobotOutline" Width="18" Height="18"/>
            <TextBlock Text="Providers" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="0,12,0,0" ColumnDefinitions="280,*">
          <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="8" Margin="0,0,0,12">
              <TextBlock Text="Engines" Theme="{StaticResource MaterialSubtitle1TextBlock}" VerticalAlignment="Center" />
              <Button Content="+" 
                      Theme="{StaticResource MaterialFlatButton}" 
                      Command="{Binding Providers.AddProviderCommand}" 
                      Padding="8,2" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Providers.Entries}"
                     SelectedItem="{Binding Providers.SelectedEntry}"
                     Theme="{StaticResource MaterialCardListBox}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="cfg:ProviderRegistryEntry">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Id}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12" DataContext="{Binding Providers}"
                        IsVisible="{Binding SelectedEntry, Converter={x:Static conv:StringConverters.IsNotNull}}">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Text="{Binding SelectedEntry.Id}" Theme="{StaticResource MaterialHeadline6TextBlock}"/>
                <Button Grid.Column="1" Content="Deregister" Command="{Binding DeregisterCommand}"
                        Theme="{StaticResource MaterialFlatButton}"
                        Foreground="{DynamicResource MaterialSecondaryMidBrush}"/>
              </Grid>
              <StackPanel Spacing="16">
                <TextBox Text="{Binding SelectedEntry.Id}" 
                         assists:TextFieldAssist.Label="Unique provider ID"
                         Theme="{StaticResource OutlineTextBox}"/>
                <TextBox Text="{Binding SelectedEntry.KeyStoreHandle}" 
                         assists:TextFieldAssist.Label="Key store handle"
                         Theme="{StaticResource OutlineTextBox}"/>
                <TextBox Text="{Binding SelectedEntry.Endpoint}" 
                         assists:TextFieldAssist.Label="Intelligence API endpoint"
                         Theme="{StaticResource OutlineTextBox}"/>
                
                <TextBlock Text="Capabilities" Theme="{StaticResource MaterialSubtitle1TextBlock}" Margin="0,8,0,0"/>
                <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="OpenAI compat" IsChecked="{Binding SelectedEntry.OpenAiCompatibility}" Margin="0,0,16,8"/>
                    <CheckBox Content="Auth required" IsChecked="{Binding SelectedEntry.AuthenticationRequired}" Margin="0,0,16,8"/>
                    <CheckBox Content="Vision" IsChecked="{Binding SelectedEntry.Vision}" Margin="0,0,16,8"/>
                    <CheckBox Content="Streaming" IsChecked="{Binding SelectedEntry.Streaming}" Margin="0,0,16,8"/>
                    <CheckBox Content="Functions" IsChecked="{Binding SelectedEntry.FunctionCalling}" Margin="0,0,16,8"/>
                    <CheckBox Content="Generic Tools" IsChecked="{Binding SelectedEntry.GenericToolUse}" Margin="0,0,16,8"/>
                </WrapPanel>

                <TextBox Text="{Binding ModalitiesString}" 
                         assists:TextFieldAssist.Label="Enabled modalities" 
                         Watermark="llm, image, audio"
                         Theme="{StaticResource OutlineTextBox}"/>
              </StackPanel>
              <Button Content="Commit changes" 
                      Theme="{StaticResource MaterialFlatMidButton}"
                      Command="{Binding CommitCommand}" 
                      HorizontalAlignment="Right"
                      Margin="0,16,0,0"/>
              
              <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDividerBrush}" Margin="0,4"/>
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MaterialSecondaryMidBrush}"
                         IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon Kind="RobotOutline" Width="18" Height="18"/>
            <TextBlock Text="Models" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Spacing="24" Margin="24" DataContext="{Binding Models}">
            <!-- Header Section -->
            <Grid ColumnDefinitions="Auto,*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                 <materialIcons:MaterialIcon Kind="Robot" Width="42" Height="42" VerticalAlignment="Center" Foreground="{DynamicResource MaterialPrimaryMidBrush}"/>
                 <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Model Registration" Theme="{StaticResource MaterialHeadline5TextBlock}" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" Opacity="0.7">
                        <TextBlock Text="Models for" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedProviderFilter}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                 </StackPanel>
              </StackPanel>

              <ComboBox Grid.Column="2" 
                        ItemsSource="{Binding ProviderFilterOptions}"
                        SelectedItem="{Binding SelectedProviderFilter}"
                        MinWidth="180"
                        assists:ComboBoxAssist.Label="Provider"
                        Theme="{StaticResource MaterialOutlineComboBox}"/>
            </Grid>

            <!-- Models List Card -->
            <Border Background="#1A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="0,12">
              <StackPanel>
                <!-- Table Header -->
                <Grid ColumnDefinitions="2*,2*,*,Auto" Margin="24,0,24,12" Opacity="0.8">
                  <TextBlock Grid.Column="0" Text="FRIENDLY NAME" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>
                  <TextBlock Grid.Column="1" Text="ENGINE VALUE" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>
                  <TextBlock Grid.Column="2" Text="MODALITY" FontSize="11" FontWeight="Bold" LetterSpacing="1" HorizontalAlignment="Center"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="cfg:ModelRegistryEntry">
                      <Border BorderBrush="#11FFFFFF" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="2*,2*,*,Auto" Margin="24,12" VerticalAlignment="Center">
                          <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding EngineValue}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>

                          <Border Grid.Column="2" CornerRadius="12" Padding="12,2" HorizontalAlignment="Center"
                                  Background="{Binding Modality, Converter={x:Static conv:StringConverters.ModalityToBrush}}">
                            <TextBlock Text="{Binding Modality, Converter={x:Static conv:StringConverters.ToUpper}}" 
                                       FontSize="9" FontWeight="Bold" Foreground="White" LetterSpacing="1"/>
                          </Border>

                          <Button Grid.Column="3" 
                                  Theme="{StaticResource MaterialFlatButton}" 
                                  Padding="4"
                                  Foreground="#EF5350"
                                  Command="{Binding $parent[UserControl].((vm:ConfigViewModel)DataContext).Models.RemoveModelCommand}"
                                  CommandParameter="{Binding}">
                             <materialIcons:MaterialIcon Kind="DeleteOutline" Width="18" Height="18" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Pagination Stub / Footer -->
                <Border BorderBrush="#11FFFFFF" BorderThickness="0,1,0,0" Padding="24,12">
                   <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                         <TextBlock Text="Items per page:" Opacity="0.7" VerticalAlignment="Center" FontSize="12"/>
                         <ComboBox SelectedIndex="0" Theme="{StaticResource MaterialFlatComboBox}" FontSize="12">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="50"/>
                         </ComboBox>
                      </StackPanel>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                         <TextBlock Text="1-3 of 3" Opacity="0.7" FontSize="12"/>
                         <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Theme="{StaticResource MaterialFlatButton}" IsEnabled="False" Opacity="0.3">
                               <materialIcons:MaterialIcon Kind="ChevronDoubleLeft" Width="16" Height="16"/>
                            </Button>
                            <Button Theme="{StaticResource MaterialFlatButton}" IsEnabled="False" Opacity="0.3">
                               <materialIcons:MaterialIcon Kind="ChevronLeft" Width="16" Height="16"/>
                            </Button>
                            <Button Theme="{StaticResource MaterialFlatButton}" IsEnabled="False" Opacity="0.3">
                               <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16"/>
                            </Button>
                            <Button Theme="{StaticResource MaterialFlatButton}" IsEnabled="False" Opacity="0.3">
                               <materialIcons:MaterialIcon Kind="ChevronDoubleRight" Width="16" Height="16"/>
                            </Button>
                         </StackPanel>
                      </StackPanel>
                   </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- Register New Endpoint Section -->
            <Border Background="#1A1A1A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,8,0,0">
               <StackPanel Spacing="16">
                  <TextBlock Text="REGISTER NEW ENDPOINT" FontSize="11" FontWeight="Bold" LetterSpacing="1" Foreground="{DynamicResource MaterialPrimaryMidBrush}" Opacity="0.9"/>

                  <Grid ColumnDefinitions="*,*,*">
                    <TextBox Grid.Column="0" Margin="0,0,12,0" 
                             Text="{Binding NewFriendlyName}" 
                             assists:TextFieldAssist.Label="Label"
                             Theme="{StaticResource OutlineTextBox}"/>
                    <TextBox Grid.Column="1" Margin="0,0,12,0" 
                             Text="{Binding NewEngineValue}" 
                             assists:TextFieldAssist.Label="Value / ID"
                             Theme="{StaticResource OutlineTextBox}"/>
                    <ComboBox Grid.Column="2" 
                              ItemsSource="{Binding ModalityOptions}" 
                              SelectedItem="{Binding NewModality}"
                              assists:ComboBoxAssist.Label="Type"
                              Theme="{StaticResource MaterialOutlineComboBox}"/>
                  </Grid>

                  <Button Content="+ ADD TO PROVIDER" 
                          Theme="{StaticResource MaterialFlatMidButton}"
                          Command="{Binding AddToProviderCommand}"
                          HorizontalAlignment="Right"
                          Padding="24,12"
                          CornerRadius="24"
                          FontWeight="SemiBold"
                          Background="{DynamicResource MaterialPrimaryMidBrush}"/>
               </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MaterialSecondaryMidBrush}"
                       HorizontalAlignment="Right"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon Kind="ScriptTextOutline" Width="18" Height="18"/>
            <TextBlock Text="Prompts" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer>
          <StackPanel Spacing="24" Margin="24" DataContext="{Binding Prompts}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                 <materialIcons:MaterialIcon Kind="ScriptText" Foreground="#00C853" Width="32" Height="32"/>
                 <TextBlock Text="System Prompts" VerticalAlignment="Center" Theme="{StaticResource MaterialHeadline5TextBlock}" FontWeight="Bold"/>
              </StackPanel>

              <Button Grid.Column="2" 
                      Command="{Binding ResetToDefaultsCommand}"
                      Theme="{StaticResource MaterialFlatButton}"
                      Foreground="#FFAB91">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                       <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18"/>
                       <TextBlock Text="RESET TO DEFAULTS" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                  </StackPanel>
              </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding PromptRows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="8" Padding="16" Background="#121212" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <DockPanel>
                      <Grid DockPanel.Dock="Top" Margin="0,0,0,16" ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" CornerRadius="4" Padding="8,2" Background="#00C853">
                          <TextBlock Text="{Binding ModalityKey, Converter={x:Static conv:StringConverters.ToUpper}}" 
                                     FontSize="10" FontWeight="Bold" Foreground="White" LetterSpacing="1"/>
                        </Border>
                        <materialIcons:MaterialIcon Grid.Column="2" Kind="ContentSaveEditOutline" Opacity="0.5" Foreground="#00C853" Width="20" Height="20"/>
                      </Grid>

                      <TextBox Text="{Binding Text}" 
                               AcceptsReturn="True" 
                               TextWrapping="Wrap" 
                               MinHeight="220"
                               Theme="{StaticResource OutlineTextBox}"
                               BorderThickness="0"
                               Background="Transparent"
                               Padding="0"
                               FontSize="13"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Save Prompt Changes" 
                    Command="{Binding SaveCommand}" 
                    Theme="{StaticResource MaterialFlatMidButton}" 
                    HorizontalAlignment="Right"
                    MinWidth="180"
                    Margin="0,16,8,0"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray" HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource MaterialSecondaryMidBrush}"
                       HorizontalAlignment="Right"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <materialIcons:MaterialIcon Kind="KeyChain" Width="18" Height="18"/>
            <TextBlock Text="Secrets" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Grid>
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="0,8,0,0" DataContext="{Binding Secrets}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Intelligence keys" FontSize="18" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="Store new secret" Command="{Binding OpenStoreDialogCommand}"/>
              </Grid>
              <TextBlock Text="Secrets are never shown after load. Replace by entering a new value." TextWrapping="Wrap" Opacity="0.8"/>
              <Border BorderBrush="#33000000" BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Service handle" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Active secret" FontWeight="SemiBold"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ApiKeyRowViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                          <StackPanel>
                            <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold"/>
                            <TextBlock Text="(configured)" Opacity="0.7" IsVisible="{Binding HasConfiguredKey}"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" MinWidth="200">
                            <TextBlock Text="New value" Opacity="0.7" FontSize="11"/>
                            <TextBox PasswordChar="*" Text="{Binding NewKeyValue}" Watermark="Replace"/>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save replacements" Command="{Binding SaveCommand}"/>
              </StackPanel>
              <TextBlock Text="{Binding StatusMessage}" Foreground="Gray"/>
              <TextBlock Text="{Binding ErrorMessage}" Foreground="#C42B1C"
                         IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </ScrollViewer>
          <Border Background="#AA000000" IsVisible="{Binding Secrets.IsStoreDialogOpen}">
            <Border Background="#FF1E1E24" CornerRadius="8" Padding="16" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel Spacing="16" DataContext="{Binding Secrets}">
                <TextBlock Text="New global secret" FontSize="16" FontWeight="SemiBold"/>
                <StackPanel Spacing="4">
                  <TextBlock Text="Service ID"/>
                  <TextBox Text="{Binding DialogServiceId}"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="Key value"/>
                  <TextBox PasswordChar="*" Text="{Binding DialogKeyValue}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                  <Button Content="Cancel" Command="{Binding CancelStoreDialogCommand}"/>
                  <Button Content="Store key" Command="{Binding StoreFromDialogCommand}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
