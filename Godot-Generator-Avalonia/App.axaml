<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Godot_Generator_Avalonia.App"
             xmlns:local="using:Godot_Generator_Avalonia"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:conv="using:Godot_Generator_Avalonia.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <themes:MaterialTheme PrimaryColor="Purple" SecondaryColor="Indigo" />
        <materialIcons:MaterialIconStyles />
    </Application.Styles>

    <Application.Resources>
        <conv:PackIconKindConverter x:Key="PackIconKindConverter" />
        <conv:MaterialIconNameToEnumConverter x:Key="MaterialIconNameToEnumConverter" />
    </Application.Resources>

</Application>
