{
  "name": "Godot Generator (Playwright + Electron)",
  "build": {
    "dockerfile": "../docker/playwright-electron/Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "workspaceFolder": "/workspaces/Godot-Generator-Avalonia",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/Godot-Generator-Avalonia,type=bind,consistency=cached",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-playwright.playwright"
      ]
    }
  },
  "postCreateCommand": "bash -lc 'dotnet --info && cd electron && pnpm install --frozen-lockfile'",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "NUGET_FALLBACK_PACKAGES": ""
  }
}
