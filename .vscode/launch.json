{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Desktop (Electron IPC)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/electron",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev:5044"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
