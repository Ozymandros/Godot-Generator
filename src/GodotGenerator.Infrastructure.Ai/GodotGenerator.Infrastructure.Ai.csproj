<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GodotGenerator.Infrastructure.Ai</RootNamespace>
    <AssemblyName>GodotGenerator.Infrastructure.Ai</AssemblyName>
    <Description>Semantic Kernel + GodotMcp.SemanticKernel.Plugin adapters.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SKEXP0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GodotGenerator.Infrastructure.Persistence\GodotGenerator.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="..\GodotGenerator.Application\GodotGenerator.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GodotMcp.SemanticKernel.Plugin" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.5" />
    <!-- NuGet package required by spec -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.74.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.74.0" />
  </ItemGroup>
</Project>
