<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GodotGenerator.Plugins</RootNamespace>
    <AssemblyName>GodotGenerator.Plugins</AssemblyName>
    <Description>Dedicated wizard plugin orchestration layer.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SKEXP0001</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GodotGenerator.Application\GodotGenerator.Application.csproj" />
    <ProjectReference Include="..\GodotGenerator.Infrastructure.Ai\GodotGenerator.Infrastructure.Ai.csproj" />
    <ProjectReference Include="..\GodotGenerator.Wizard.Contracts\GodotGenerator.Wizard.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.6" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.74.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.74.0" />

    <!--
      TODO: Add the following NuGet packages when they are available, then replace the
      stub implementations in WizardExternalPluginFactory.cs with the real API calls.

      <PackageReference Include="ElevenLabs.McpClient" Version="x.y.z" />
        https://www.nuget.org/packages/ElevenLabs.McpClient

      <PackageReference Include="ImageGenMcp.SemanticKernel.Plugin" Version="x.y.z" />
        https://www.nuget.org/packages/ImageGenMcp.SemanticKernel.Plugin
    -->
  </ItemGroup>

</Project>
