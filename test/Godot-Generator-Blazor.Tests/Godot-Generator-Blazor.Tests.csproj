<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Godot_Generator_Blazor.Tests</RootNamespace>
    <Include>[Godot-Generator-Blazor]Godot_Generator_Blazor.Services.*,[Godot-Generator-Blazor]Godot_Generator_Blazor.State.*,[Godot-Generator-Blazor]Godot_Generator_Blazor.Models.*</Include>
