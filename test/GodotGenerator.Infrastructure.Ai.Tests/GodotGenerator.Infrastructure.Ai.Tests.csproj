<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>GodotGenerator.Infrastructure.Ai.Tests</RootNamespace>
  </PropertyGroup>
  <!-- Enable coverage collection and enforce minimum coverage threshold -->
  <PropertyGroup>
    <!-- Collect coverage by default when running dotnet test -->
    <CollectCoverage>true</CollectCoverage>
    <!-- Output folder for coverage reports -->
    <CoverletOutput>$(MSBuildProjectDirectory)\TestResults\</CoverletOutput>
    <!-- Produce Cobertura format (useful for many CI systems) -->
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <!-- Measure only AI infrastructure; kernel factory is integration-heavy (MCP process). -->
    <Include>[GodotGenerator.Infrastructure.Ai]*</Include>
    <ExcludeByFile>**/KernelFactory/GodotKernelFactory.cs,**/DependencyInjection/*.cs,**/GodotProjectPathValidator.cs</ExcludeByFile>
    <!-- Excludes kernel factory and DI glue; core services ~63% line. -->
    <Threshold>60</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GodotGenerator.Infrastructure.Ai\GodotGenerator.Infrastructure.Ai.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="coverlet.msbuild" Version="3.2.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
