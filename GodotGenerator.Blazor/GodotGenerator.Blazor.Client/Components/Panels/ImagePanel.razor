@* Unity-Generator ImagePanel parity (constraints + aspect/quality hints). *@
@inject ProjectStateService ProjectState

<GenerationWorkspace Modality="GenerationModality.Image"
                     Title="Image Generation"
                     Description="Describe the image; aspect and quality are sent as request hints."
                     PromptPlaceholder="Describe the image…"
                     CreateRequest="BuildRequest">
    <AdditionalFields>
        <SmartField Label="Aspect ratio"
                    FieldType="@SmartFieldType.Select"
                    InputKind="Select"
                    Placeholder="—"
                    SelectOptions="_aspectRatioOptions"
                    @bind-Value="_aspectRatio" />
        <SmartField Label="Quality"
                    FieldType="@SmartFieldType.Select"
                    InputKind="Select"
                    Placeholder="—"
                    SelectOptions="_qualityOptions"
                    @bind-Value="_quality" />
        <SmartField Label="Size / aspect / style constraints" FieldType="SmartFieldType.Multiline" Rows="2" Placeholder="e.g. 1024×1024, square, pixel art" @bind-Value="_constraints" />
    </AdditionalFields>
</GenerationWorkspace>

@code {
    private static readonly string[] _aspectRatioOptions =
    [
        "1:1", "4:3", "3:4", "16:9", "9:16", "21:9", "2:3", "3:2",
    ];

    private static readonly string[] _qualityOptions =
    [
        "Draft", "Standard", "High", "Ultra",
    ];

    private string _aspectRatio = "1:1";
    private string _quality = "Standard";
    private string _constraints = string.Empty;

    private GenerateRequest BuildRequest(string prompt)
    {
        var options = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(_aspectRatio))
        {
            options["aspect_ratio"] = _aspectRatio.Trim();
        }

        if (!string.IsNullOrWhiteSpace(_quality))
        {
            options["quality"] = _quality.Trim();
        }

        var body = string.IsNullOrWhiteSpace(_constraints)
            ? prompt
            : $"Image constraints: {_constraints.Trim()}{Environment.NewLine}{Environment.NewLine}{prompt}";

        return new GenerateRequest(
            Prompt: body,
            ProjectName: string.IsNullOrWhiteSpace(ProjectState.ActiveProjectName) ? null : ProjectState.ActiveProjectName.Trim(),
            Options: options.Count > 0 ? options : null);
    }
}
