@* Wizard: orchestrates multiple generation tools to fulfil a project-scoped goal.
   The Wizard LLM selects which tools to call (code, scenes, physics, lighting, etc.)
   and returns a consolidated summary. Functionally similar to Code panel but
   backed by a separate SK kernel that exposes the full GodotGeneratorApi plugin. *@
@inject ProjectStateService ProjectState
@inject IJSRuntime JS
@implements IAsyncDisposable

<GenerationWorkspace Modality="GenerationModality.Wizard"
                     Title="Wizard"
                     Badge="Orchestrator"
                     Description="Describe your project goal. The Wizard orchestrates multiple generation tools — code, scenes, physics, lighting, shaders, and more — to accomplish it in one turn."
                     PromptPlaceholder="Describe what you want to build or configure in your Godot 4 project…"
                     CreateRequest="BuildRequest"
                     ShowLiveActivity="false">
    <AdditionalFields>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="6">
            <FluentLabel Typo="Typography.Body" Class="app-opacity-muted-soft">
                The Wizard uses your configured LLM provider with access to all Godot Generator tools.
                It may make several generation calls in sequence — complex goals may take longer than a single panel.
            </FluentLabel>
            <SmartField Label="Godot project path (optional)"
                        Placeholder="e.g. C:\Projects\MyGame or /home/user/MyGame"
                        Help="When set, MCP-aware tools can validate node paths and scene references."
                        @bind-Value="_godotProjectPath" />

            @if (_progressLines.Count > 0)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                    <FluentLabel Typo="Typography.Body" Class="app-fluent-label-strong">
                        Live activity
                    </FluentLabel>
                    <textarea class="wizard-progress-log"
                              rows="6"
                              readonly
                              aria-label="Wizard live activity log"
                              aria-live="polite">@string.Join("\n", _progressLines)</textarea>
                </FluentStack>
            }
        </FluentStack>
    </AdditionalFields>
</GenerationWorkspace>

@code {
    /// <summary>Fixed key used to scope the generation progress JS subscription.</summary>
    private const string ProgressSubscriptionKey = "wizard-panel";

    private string _godotProjectPath = string.Empty;
    private readonly List<string> _progressLines = [];
    private DotNetObjectReference<WizardPanel>? _dotNetRef;

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync(
            "godotElectronInterop.subscribeGenerationProgress",
            _dotNetRef,
            ProgressSubscriptionKey);
    }

    /// <summary>
    /// Invoked by JS when a generation progress frame arrives over the IPC pipe.
    /// Clears the log on turn-start and appends each frame's human-readable message.
    /// </summary>
    /// <param name="phase">One of <c>status</c>, <c>tool</c>, or <c>llm</c>.</param>
    /// <param name="message">Human-readable description of the current activity.</param>
    /// <param name="toolPlugin">Plugin name when <paramref name="phase"/> is <c>tool</c>; otherwise <c>null</c>.</param>
    /// <param name="toolName">Function name when <paramref name="phase"/> is <c>tool</c>; otherwise <c>null</c>.</param>
    [JSInvokable]
    public void OnGenerationProgress(string phase, string message, string? toolPlugin, string? toolName)
    {
        // A "starting" status frame signals a new wizard turn — clear stale progress.
        if (string.Equals(phase, "status", StringComparison.OrdinalIgnoreCase) &&
            message.Contains("starting", StringComparison.OrdinalIgnoreCase))
        {
            _progressLines.Clear();
        }

        if (!string.IsNullOrWhiteSpace(message))
        {
            _progressLines.Add(message);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "godotElectronInterop.unsubscribeGenerationProgress",
                ProgressSubscriptionKey);
        }
        catch (JSDisconnectedException)
        {
            // JS runtime has already disconnected (e.g. navigation or app close); safe to swallow.
        }
        catch (TaskCanceledException)
        {
            // Page tearing down — swallow.
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }

    /// <summary>Builds the wizard generation request from the current panel state.</summary>
    /// <param name="prompt">The user-supplied prompt.</param>
    /// <returns>A <see cref="GenerateRequest"/> ready for dispatch.</returns>
    private GenerateRequest BuildRequest(string prompt)
    {
        var options = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);

        // Forward the active project path for tool-level MCP validation if available.
        var projectPath = !string.IsNullOrWhiteSpace(_godotProjectPath)
            ? _godotProjectPath.Trim()
            : ProjectState.ActiveProjectPath;

        if (!string.IsNullOrWhiteSpace(projectPath))
        {
            options[GenerationOptionKeys.GodotProjectPath] = projectPath;
        }

        return new GenerateRequest(
            Prompt: prompt,
            ProjectName: string.IsNullOrWhiteSpace(ProjectState.ActiveProjectName)
                ? null
                : ProjectState.ActiveProjectName.Trim(),
            Options: options.Count > 0 ? options : null);
    }
}
