@inject IJSRuntime Js
@implements IAsyncDisposable

<FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="8" role="group" aria-labelledby="theme-toggle-label">
    <FluentLabel Typo="Typography.Body" id="theme-toggle-label">Theme</FluentLabel>
    <FluentSelect TValue="string" 
                  Value="@_currentPreference" 
                  ValueChanged="@OnPreferenceChangedAsync"
                  aria-labelledby="theme-toggle-label"
                  aria-describedby="theme-toggle-description">
        <FluentOption value="system">System</FluentOption>
        <FluentOption value="light">Light</FluentOption>
        <FluentOption value="dark">Dark</FluentOption>
    </FluentSelect>
</FluentStack>
<FluentLabel Typo="Typography.Caption" id="theme-toggle-description" Class="visually-hidden">Select your preferred color theme</FluentLabel>

@code {
    private string _currentPreference = "system";
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            try
            {
                var preference = await Js.InvokeAsync<string>("godotTheme.getPreference").ConfigureAwait(false);
                _currentPreference = preference ?? "system";
                StateHasChanged();
            }
            catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
            {
                // Prerender / circuit not attached yet; use default
                _currentPreference = "system";
            }
        }
    }

    private async Task OnPreferenceChangedAsync(string value)
    {
        _currentPreference = value;
        try
        {
            await Js.InvokeVoidAsync("godotTheme.setPreference", _currentPreference).ConfigureAwait(false);
        }
        catch (Exception ex) when (ex is InvalidOperationException or JSDisconnectedException)
        {
            // Prerender / circuit not attached yet; theme applies on next interactive render.
        }
    }

    public async ValueTask DisposeAsync()
    {
        // Cleanup if needed
        await ValueTask.CompletedTask;
    }
}
