@page "/"
@rendermode InteractiveWebAssembly

<PageTitle>Home</PageTitle>

<FluentLabel Typo="Typography.H3" Class="app-fluent-label-margin-title">Godot Generator</FluentLabel>
<FluentLabel Typo="Typography.Body" Class="app-fluent-intro-desc app-fluent-intro-desc--home">
    Web shell with Fluent UI, server-side BFF, and shared generation primitives. Use the sidebar to open a modality or settings.
</FluentLabel>

<FluentCard Class="app-card-padding--spacious">
    <FluentLabel Typo="Typography.H6" Class="app-fluent-title-tight">Quick links</FluentLabel>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <FluentAnchor Href="/generate/godot-project">Godot Project</FluentAnchor>
        <FluentAnchor Href="/generate/scenes">Scenes</FluentAnchor>
        <FluentAnchor Href="/settings">Configuration</FluentAnchor>
    </FluentStack>
</FluentCard>
