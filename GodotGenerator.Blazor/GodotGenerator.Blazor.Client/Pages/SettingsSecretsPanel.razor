@inject GodotGeneratorClientFacade Api
@inject IJSRuntime JS

<div class="settings-secrets">
    @if (!string.IsNullOrEmpty(_panelError))
    {
        <AppMessageBar Intent="MessageIntent.Error" Class="settings-secrets__msg">@_panelError</AppMessageBar>
    }
    @if (!string.IsNullOrEmpty(_panelInfo))
    {
        <AppMessageBar Intent="MessageIntent.Success" Class="settings-secrets__msg">@_panelInfo</AppMessageBar>
    }

    <div class="settings-secrets__toolbar">
        <div class="settings-secrets__title-row">
            <FluentIcon Value="@(new Icons.Regular.Size20.Key())" Width="24px" Color="Color.Neutral" />
            <h2 class="settings-secrets__title" id="settings-secrets-heading">Intelligence Keys</h2>
        </div>
        <FluentButton Appearance="Appearance.Accent"
                      Disabled="@Disabled"
                      class="settings-secrets__cta"
                      aria-describedby="settings-secrets-heading"
                      OnClick="OpenStoreDialogAsync">
            <FluentIcon Value="@(new Icons.Regular.Size20.Add())" Width="18px" Color="Color.FillInverse" />
            <span>STORE NEW SECRET</span>
        </FluentButton>
    </div>

    <div class="settings-secrets__table-wrap" role="region" aria-labelledby="settings-secrets-heading">
        <table class="settings-secrets__table">
            <caption class="settings-secrets__caption">
                <span class="settings-secrets__visually-hidden">API keys by service handle. Stored values are never shown in full.</span>
            </caption>
            <thead>
                <tr>
                    <th scope="col">Service handle</th>
                    <th scope="col">Active secret</th>
                    <th scope="col">Replace</th>
                    <th scope="col" class="settings-secrets__col-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (PagedHandles.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="settings-secrets__empty" role="status">No data available.</td>
                    </tr>
                }
                else
                {
                    @foreach (var handle in PagedHandles)
                    {
                        <tr>
                            <td>
                                <span class="settings-secrets__handle" title="@handle">@handle</span>
                            </td>
                            <td>
                                <span class="settings-secrets__mask" aria-hidden="true">••••••••</span>
                                <span class="settings-secrets__visually-hidden">Stored secret is hidden.</span>
                            </td>
                            <td>
                                <SmartField Label=""
                                            FieldType="@SmartFieldType.Password"
                                            Placeholder="New value"
                                            Value="@GetReplace(handle)"
                                            ValueChanged="@(v => OnReplaceChanged(handle, v))"
                                            Disabled="@Disabled"
                                            InputClass="settings-secrets__replace-field" />
                            </td>
                            <td class="settings-secrets__col-actions">
                                <FluentButton Appearance="Appearance.Neutral"
                                              Disabled="@Disabled"
                                              class="settings-secrets__remove"
                                              aria-label="@($"Remove stored secret for {handle}")"
                                              OnClick="@(() => RemoveAsync(handle))">
                                    Remove
                                </FluentButton>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="settings-secrets__pager" role="navigation" aria-label="Secret list pagination">
        <label class="settings-secrets__page-size">
            <span class="settings-secrets__page-size-label">Items per page</span>
            <SmartField Label=""
                        FieldType="@SmartFieldType.Select"
                        Disabled="@Disabled"
                        SelectOptions="PageSizeOptions"
                        Value="@_pageSizeText"
                        ValueChanged="OnPageSizeChangedAsync"
                        InputClass="settings-secrets__page-size-combo" />
        </label>
        <span class="settings-secrets__range" aria-live="polite">@RangeLabel</span>
        <div class="settings-secrets__nav-buttons">
            <FluentButton Appearance="Appearance.Neutral"
                          Disabled="@(Disabled || !CanFirst)"
                          aria-label="First page"
                          class="settings-secrets__icon-btn"
                          OnClick="FirstPage">«</FluentButton>
            <FluentButton Appearance="Appearance.Neutral"
                          Disabled="@(Disabled || !CanPrev)"
                          aria-label="Previous page"
                          class="settings-secrets__icon-btn"
                          OnClick="PrevPage">‹</FluentButton>
            <FluentButton Appearance="Appearance.Neutral"
                          Disabled="@(Disabled || !CanNext)"
                          aria-label="Next page"
                          class="settings-secrets__icon-btn"
                          OnClick="NextPage">›</FluentButton>
            <FluentButton Appearance="Appearance.Neutral"
                          Disabled="@(Disabled || !CanLast)"
                          aria-label="Last page"
                          class="settings-secrets__icon-btn"
                          OnClick="LastPage">»</FluentButton>
        </div>
    </div>

    <div class="settings-secrets__commit">
        <FluentButton Appearance="Appearance.Neutral"
                      Disabled="@(Disabled || _busy || !HasReplacements)"
                      OnClick="SaveReplacementsAsync">Save replacements</FluentButton>
    </div>

    <AppMessageBar Intent="MessageIntent.Info" Class="settings-secrets__hint">
        Keys managed here are stored securely on the backend and shared across providers using the same handle.
    </AppMessageBar>
</div>

<FluentDialog Hidden="@(!_storeOpen)"
              Modal="true"
              TrapFocus="true"
              Style="--dialog-width: min(100vw - 32px, 420px);"
              aria-labelledby="settings-secrets-dialog-title">
    <FluentDialogHeader>
        <FluentLabel Typo="Typography.H5" Id="settings-secrets-dialog-title">Store new secret</FluentLabel>
    </FluentDialogHeader>
    <FluentDialogBody>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
            <SmartField Label="Service handle"
                        Help="Identifier shared with provider key store handles (e.g. openai, anthropic)."
                        Value="@_dialogHandle"
                        ValueChanged="OnDialogHandleChanged"
                        Disabled="@Disabled"
                        Width="100%" />
            <SmartField Label="Secret value"
                        FieldType="@SmartFieldType.Password"
                        Help="Stored server-side; not shown again after save."
                        Value="@_dialogSecret"
                        ValueChanged="OnDialogSecretChanged"
                        Disabled="@Disabled"
                        Width="100%" />
        </FluentStack>
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" Disabled="@(Disabled || _busy)" OnClick="CommitStoreAsync">Store secret</FluentButton>
        <FluentButton Appearance="Appearance.Neutral" Disabled="@_busy" OnClick="CloseStoreDialog">Cancel</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private readonly List<string> _handles = [];
    private readonly Dictionary<string, string> _replaceDraft = new(StringComparer.OrdinalIgnoreCase);
    private int _lastEpoch = int.MinValue;
    private string? _panelError;
    private string? _panelInfo;
    private bool _busy;
    private bool _storeOpen;
    private string _dialogHandle = string.Empty;
    private string _dialogSecret = string.Empty;
    private int _page;
    private int _pageSize = 10;
    private string _pageSizeText = "10";
    private static readonly string[] PageSizeOptions = ["5", "10", "25"];

    [Parameter]
    public int ConfigEpoch { get; set; }

    [Parameter]
    public IReadOnlyList<string> SourceKeyNames { get; set; } = Array.Empty<string>();

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnSecretsSaved { get; set; }

    private IReadOnlyList<string> PagedHandles
    {
        get
        {
            var start = _page * _pageSize;
            return _handles.Skip(start).Take(_pageSize).ToList();
        }
    }

    private int Total => _handles.Count;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Total / (double)_pageSize));

    private string RangeLabel
    {
        get
        {
            if (Total == 0)
            {
                return "0–0 of 0";
            }

            var start = _page * _pageSize + 1;
            var end = Math.Min(Total, (_page + 1) * _pageSize);
            return $"{start}–{end} of {Total}";
        }
    }

    private bool CanPrev => _page > 0;

    private bool CanNext => _page < PageCount - 1;

    private bool CanFirst => CanPrev;

    private bool CanLast => CanNext;

    private bool HasReplacements =>
        _replaceDraft.Values.Any(v => !string.IsNullOrWhiteSpace(v));

    protected override void OnParametersSet()
    {
        if (_lastEpoch == ConfigEpoch)
        {
            return;
        }

        _lastEpoch = ConfigEpoch;
        SyncHandlesFromSource();
    }

    private void SyncHandlesFromSource()
    {
        _handles.Clear();
        foreach (var h in SourceKeyNames)
        {
            if (!string.IsNullOrWhiteSpace(h))
            {
                _handles.Add(h.Trim());
            }
        }

        _handles.Sort(StringComparer.OrdinalIgnoreCase);
        _pageSizeText = _pageSize.ToString(System.Globalization.CultureInfo.InvariantCulture);
        foreach (var key in _replaceDraft.Keys.ToList())
        {
            if (!_handles.Contains(key, StringComparer.OrdinalIgnoreCase))
            {
                _replaceDraft.Remove(key);
            }
        }

        ClampPage();
    }

    private void ClampPage()
    {
        if (_pageSize <= 0)
        {
            _pageSize = 10;
        }

        var maxPage = Math.Max(0, PageCount - 1);
        if (_page > maxPage)
        {
            _page = maxPage;
        }
    }

    private string GetReplace(string handle)
    {
        return _replaceDraft.TryGetValue(handle, out var v) ? v : string.Empty;
    }

    private Task OnReplaceChanged(string handle, string value)
    {
        _replaceDraft[handle] = value;
        return Task.CompletedTask;
    }

    private Task OnDialogHandleChanged(string v)
    {
        _dialogHandle = v;
        return Task.CompletedTask;
    }

    private Task OnDialogSecretChanged(string v)
    {
        _dialogSecret = v;
        return Task.CompletedTask;
    }

    private Task OnPageSizeChangedAsync(string value)
    {
        _pageSizeText = value;
        if (int.TryParse(_pageSizeText, out var parsed) && (parsed == 5 || parsed == 10 || parsed == 25))
        {
            _pageSize = parsed;
        }
        else
        {
            _pageSizeText = _pageSize.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }

        _page = 0;
        ClampPage();
        return Task.CompletedTask;
    }

    private void FirstPage()
    {
        _page = 0;
    }

    private void PrevPage()
    {
        if (CanPrev)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (CanNext)
        {
            _page++;
        }
    }

    private void LastPage()
    {
        _page = Math.Max(0, PageCount - 1);
    }

    private Task OpenStoreDialogAsync()
    {
        _panelError = null;
        _panelInfo = null;
        _dialogHandle = string.Empty;
        _dialogSecret = string.Empty;
        _storeOpen = true;
        return Task.CompletedTask;
    }

    private Task CloseStoreDialog()
    {
        _storeOpen = false;
        return Task.CompletedTask;
    }

    private async Task CommitStoreAsync()
    {
        var name = _dialogHandle.Trim();
        var secret = _dialogSecret.Trim();
        if (string.IsNullOrEmpty(name) || string.IsNullOrEmpty(secret))
        {
            _panelError = "Service handle and secret value are required.";
            return;
        }

        _busy = true;
        _panelError = null;
        _panelInfo = null;
        try
        {
            var res = await Api.SaveApiKeysEnvelopeAsync(new ApiKeysRequest(new Dictionary<string, string?> { [name] = secret }))
                .ConfigureAwait(false);
            if (!res.Success)
            {
                _panelError = res.Error ?? "Failed to store secret.";
                return;
            }

            _panelInfo = "Secret stored.";
            _storeOpen = false;
            _dialogHandle = string.Empty;
            _dialogSecret = string.Empty;
            await OnSecretsSaved.InvokeAsync().ConfigureAwait(false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveReplacementsAsync()
    {
        var batch = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var (h, v) in _replaceDraft)
        {
            var t = v.Trim();
            if (t.Length > 0)
            {
                batch[h] = t;
            }
        }

        if (batch.Count == 0)
        {
            _panelInfo = "Enter a new secret in Replace, or use Store new secret.";
            return;
        }

        _busy = true;
        _panelError = null;
        _panelInfo = null;
        try
        {
            var res = await Api.SaveApiKeysEnvelopeAsync(new ApiKeysRequest(batch)).ConfigureAwait(false);
            if (!res.Success)
            {
                _panelError = res.Error ?? "Failed to save replacements.";
                return;
            }

            foreach (var h in batch.Keys)
            {
                _replaceDraft[h] = string.Empty;
            }

            _panelInfo = "Replacements saved.";
            await OnSecretsSaved.InvokeAsync().ConfigureAwait(false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(string handle)
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Remove stored secret for '{handle}'? This cannot be undone.");
        if (!ok)
        {
            return;
        }

        _busy = true;
        _panelError = null;
        _panelInfo = null;
        try
        {
            var res = await Api.SaveApiKeysEnvelopeAsync(new ApiKeysRequest(new Dictionary<string, string?> { [handle] = null }))
                .ConfigureAwait(false);
            if (!res.Success)
            {
                _panelError = res.Error ?? "Failed to remove secret.";
                return;
            }

            _replaceDraft.Remove(handle);
            _panelInfo = $"Removed secret for {handle}.";
            await OnSecretsSaved.InvokeAsync().ConfigureAwait(false);
        }
        finally
        {
            _busy = false;
        }
    }
}

